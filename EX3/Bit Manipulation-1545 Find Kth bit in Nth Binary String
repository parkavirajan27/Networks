#include <math.h>

char findKthBit(int n, int k) {
    if (n == 1) {
        return '0';
    }
    int mid = 1 << (n - 1);
    if (k == mid) {
        return '1';
    }
    else if (k < mid) {
        return findKthBit(n - 1, k);
    }
    else {
        int symmetric_k = mid * 2 - k;
        char bit = findKthBit(n - 1, symmetric_k);
        return (bit == '0') ? '1' : '0';
    }
}
