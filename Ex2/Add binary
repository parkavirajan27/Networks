#include<stdio.h>
#include <string.h>
#include <stdlib.h>

char* addBinary(char* a, char* b) {
    int len_a = strlen(a);
    int len_b = strlen(b);
    int max_len = (len_a > len_b ? len_a : len_b) + 1;
    char* result = (char*)malloc((max_len + 1) * sizeof(char));
    int i = len_a - 1;
    int j = len_b - 1;
    int k = max_len;
    int carry = 0;
    result[k] = '\0';
    k--;
    while (i >= 0 || j >= 0 || carry) {
        int sum = carry;
        
        if (i >= 0) {
            sum += a[i] - '0'; 
            i--;
        }
        if (j >= 0) {
            sum += b[j] - '0'; 
            j--;
        }
        
        result[k] = (sum % 2) + '0'; 
        carry = sum / 2;
        k--;
    }
    return &result[k + 1];
}
