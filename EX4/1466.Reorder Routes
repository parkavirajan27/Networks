#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>

// Structure to represent a graph edge
typedef struct Edge {
    int to;
    bool isOriginal; // true if direction is A -> B, false if artificial B -> A
    struct Edge* next;
} Edge;

// Global counter for roads that need reordering
int reorderCount;

// Depth-First Search traversal
void dfs(int node, Edge** graph, bool* visited) {
    visited[node] = true;
    
    Edge* curr = graph[node];
    while (curr != NULL) {
        if (!visited[curr->to]) {
            // If the road goes away from city 0 (original direction), we must flip it
            if (curr->isOriginal) {
                reorderCount++;
            }
            dfs(curr->to, graph, visited);
        }
        curr = curr->next;
    }
}

int minReorder(int n, int** connections, int connectionsSize, int* connectionsColSize) {
    reorderCount = 0;
    
    // Allocate memory for the adjacency list representation
    Edge** graph = (Edge**)calloc(n, sizeof(Edge*));
    bool* visited = (bool*)calloc(n, sizeof(bool));
    
    // Build the graph adding both original and reverse edges
    for (int i = 0; i < connectionsSize; i++) {
        int u = connections[i][0];
        int v = connections[i][1];
        
        // Original directed edge: u -> v (Moving away from u)
        Edge* edge1 = (Edge*)malloc(sizeof(Edge));
        edge1->to = v;
        edge1->isOriginal = true;
        edge1->next = graph[u];
        graph[u] = edge1;
        
        // Artificial reverse edge: v -> u (Moving towards u)
        Edge* edge2 = (Edge*)malloc(sizeof(Edge));
        edge2->to = u;
        edge2->isOriginal = false;
        edge2->next = graph[v];
        graph[v] = edge2;
    }
    
    // Start DFS from city 0
    dfs(0, graph, visited);
    
    // Free allocated memory to avoid memory leaks
    for (int i = 0; i < n; i++) {
        Edge* curr = graph[i];
        while (curr != NULL) {
            Edge* toFree = curr;
            curr = curr->next;
            free(toFree);
        }
    }
    free(graph);
    free(visited);
    
    return reorderCount;
}
