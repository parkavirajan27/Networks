int findCheapestPrice(int n, int** flights, int flightsSize, int* flightsColSize, int src, int dst, int k) {
    const int INF = 1e9;
    int* prices = (int*)malloc(n * sizeof(int));
    int* tempPrices = (int*)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        prices[i] = INF;
    }
    prices[src] = 0;
    for (int i = 0; i <= k; i++) {
        for (int j = 0; j < n; j++) {
            tempPrices[j] = prices[j];
        }
        for (int j = 0; j < flightsSize; j++) {
            int u = flights[j][0];
            int v = flights[j][1];
            int w = flights[j][2];
            if (prices[u] != INF && prices[u] + w < tempPrices[v]) {
                tempPrices[v] = prices[u] + w;
            }
        }
        for (int j = 0; j < n; j++) {
            prices[j] = tempPrices[j];
        }
    }
    int result = (prices[dst] == INF) ? -1 : prices[dst];
    free(prices);
    free(tempPrices);
    return result;
}
